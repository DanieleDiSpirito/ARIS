# =========================================================================
# ARIS - Environment Variables Template
# Copy this file to .env and fill in your details.
# =========================================================================

# 🌐 API Key per OpenRouter (per LLM e Embedding cloud)
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# 💻 Configurazione LLM Locale (es. LM Studio o Ollama)
LOCAL_LLM_MODEL="phi3.5"
LOCAL_LLM_URL="http://localhost:1234/v1"

# 🛠️ LangSmith (Opzionale: per tracing e debugging della pipeline RAG)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="aris-project"
